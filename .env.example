# ==============================================================================
# AtlasOS Environment Configuration
# Copy this file to .env and fill in your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_secret
POSTGRES_DB=atlasos

# Async driver for FastAPI application (asyncpg)
DATABASE_URL=postgresql+asyncpg://atlas:atlas_secret@postgres:5432/atlasos

# Sync driver for Alembic migrations (psycopg2)
DATABASE_URL_SYNC=postgresql+psycopg2://atlas:atlas_secret@postgres:5432/atlasos

# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ------------------------------------------------------------------------------
# Qdrant Vector Database
# ------------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ------------------------------------------------------------------------------
# Security & Secrets
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# ------------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_SECRET_KEY=change-me-to-another-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# Embedding Provider
# Options: bge-large | openai | gemini | voyageai | jina | custom
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=bge-large
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024
EMBEDDING_SERVICE_URL=http://embedding-service:8001

# Provider-specific API keys (only needed for the selected provider)
OPENAI_API_KEY=
GEMINI_API_KEY=
VOYAGEAI_API_KEY=
JINA_API_KEY=
CUSTOM_EMBEDDING_URL=

# ------------------------------------------------------------------------------
# NLI (Natural Language Inference) Service
# Self-hosted roberta-large-mnli in a dedicated container
# ------------------------------------------------------------------------------
NLI_SERVICE_URL=http://nli-service:8002
NLI_MODEL=roberta-large-mnli

# ------------------------------------------------------------------------------
# OAuth2 Providers (Console Authentication)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed origins
# ------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-string
NEXT_PUBLIC_API_URL=http://localhost:8000
